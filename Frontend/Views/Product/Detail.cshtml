@model ProductDetailDto
@inject IConfiguration Configuration
@section Styles {
    <link rel="stylesheet" href="~/css/product-detail.css" asp-append-version="true" />
    <style>
        .coupon-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
            max-height: 180px;
            overflow-y: auto;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 6px;
        }
        .coupon-item {
            display: flex;
            gap: 10px;
            align-items: center;
            padding: 8px 10px;
            border: 1px solid transparent;
            border-radius: 4px;
            cursor: pointer;
        }
        .coupon-item:hover {
            background: #f5f5f5;
        }
        .coupon-item.selected {
            border-color: #0d6efd;
            background: #eaf2ff;
        }
    </style>
}
@{
    ViewData["Title"] = Model.Title ?? "Product Detail";
    var sortedRatings = Model.RatingCounts.OrderByDescending(kv => kv.Key);
    var paypalClientId = ViewBag.PayPalClientId as string ?? Configuration["PayPal:ClientId"];
    var paypalCurrency = ViewBag.PayPalCurrency as string ?? Configuration["PayPal:Currency"] ?? "USD";
    var productPrice = (Model.Price ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture);
    var addresses = ViewBag.Addresses as List<Backend.DTOs.Responses.AddressDto>;
    var coupons = ViewBag.Coupons as List<Backend.DTOs.Responses.CouponDto>;
}

<div class="container product-detail-container">
    <div class="row">
        <div class="col-md-5">
            <img src="@Model.Images" alt="@Model.Title" class="img-fluid product-detail-image" />
        </div>

        <div class="col-md-7">
            <h1 class="product-detail-title">@Model.Title</h1>

            <div class="product-detail-seller">
                <span>Sold by: </span>
                <a href="#">@Model.SellerName</a> |
                <span>Category: </span>
                <a href="#">@Model.CategoryName</a>
                @if (Model.SellerId != null)
                {
                    <span> | </span>
                    <button type="button" class="btn btn-sm btn-outline-primary ms-2" id="chat-with-seller" data-seller-id="@Model.SellerId" data-seller-name="@Model.SellerName">Chat with seller</button>
                }
            </div>

            <hr />

            <div class="product-detail-quick-rating">
                <span class="star-display">
                    @Model.AverageRating.ToString("F1") ★
                </span>
                <a href="#ratings-reviews" class="ms-2">@Model.ReviewCount ratings</a>
            </div>

            <div class="product-detail-price">
                US $@Model.Price?.ToString("#,##0.00")
            </div>

            @if (TempData["BuyError"] != null)
            {
                <div class="alert alert-danger">@TempData["BuyError"]</div>
            }

            <form asp-controller="Product" asp-action="Buy" method="post" class="checkout-form" data-product-id="@Model.Id" data-product-price="@productPrice">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="checkout-options">
                    <div class="checkout-field">
                        <label for="paymentMethod" class="form-label">Payment method</label>
                        <select id="paymentMethod" name="paymentMethod" class="form-select">
                            <option value="COD" selected>Cash on delivery (COD)</option>
                            <option value="PayPal">PayPal</option>
                        </select>
                    </div>

                    <div class="checkout-field">
                        <label for="addressId" class="form-label">Shipping address</label>
                        @if (addresses != null && addresses.Any())
                        {
                            <select id="addressId" name="addressId" class="form-select">
                                @foreach (var addr in addresses)
                                {
                                    <option value="@addr.Id" selected="@(addr.IsDefault ? "selected" : null)">
                                        @addr.Street, @addr.City, @addr.Country @(addr.IsDefault ? "(Mặc định)" : "")
                                    </option>
                                }
                            </select>
                            <a asp-controller="Address" asp-action="Create" asp-route-returnProductId="@Model.Id" class="form-text">+ Thêm địa chỉ mới</a>
                        }
                        else
                        {
                            <p class="form-text text-danger mb-1">Bạn chưa có địa chỉ giao hàng.</p>
                            <a asp-controller="Address" asp-action="Create" asp-route-returnProductId="@Model.Id" class="btn btn-sm btn-outline-primary">+ Thêm địa chỉ giao hàng</a>
                        }
                    </div>

                    <div class="checkout-field">
                        <label for="quantity" class="form-label">Quantity</label>
                        <input type="number" id="quantity" name="quantity" class="form-control" value="1" min="1" />
                    </div>

                    <div class="checkout-field">
                        <label class="form-label">Available coupons</label>

                        @* Hidden input giữ mã coupon đang chọn, JS set giá trị khi user click chọn *@
                        <input type="hidden" id="couponCode" name="couponCode" value="" />

                        @if (coupons != null && coupons.Any())
                        {
                            <div class="coupon-list" id="couponList">
                                <div class="coupon-item selected" data-code="">
                                    <span>No coupon</span>
                                </div>
                                @foreach (var c in coupons)
                                {
                                    <div class="coupon-item" data-code="@c.Code">
                                        <span class="fw-bold">@c.Code</span>
                                        <span class="text-success">-@c.DiscountPercent%</span>
                                        @if (c.EndDate.HasValue)
                                        {
                                            <span class="text-muted small">HSD: @c.EndDate.Value.ToString("dd-MMM-yyyy")</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="form-text text-muted mb-0">Không có mã giảm giá nào áp dụng cho sản phẩm này.</p>
                        }

                        <div id="couponMessage" class="form-text"></div>
                    </div>

                    <div class="checkout-summary" id="orderSummaryBox">
                        <div class="d-flex justify-content-between">
                            <span>Subtotal</span>
                            <strong id="summarySubTotal">US $0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between text-success" id="summaryDiscountRow" style="display:none;">
                            <span>Discount</span>
                            <strong id="summaryDiscount">- US $0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Shipping</span>
                            <strong id="summaryShippingFee">US $0.00</strong>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between fs-5">
                            <span>Total</span>
                            <strong id="summaryTotal">US $@Model.Price?.ToString("#,##0.00")</strong>
                        </div>
                        <div id="summaryError" class="text-danger small mt-1"></div>
                    </div>
                </div>
                <button type="submit" class="btn btn-buy-now">Buy It Now</button>
                <div id="paypal-button-container" class="mt-3" style="display:none;"></div>
                <div id="paypal-error" class="text-danger small mt-2"></div>
                <button type="button" class="btn btn-add-cart">Add to cart</button>
                <button type="button" class="btn btn-watch-list">Add to Watchlist</button>
            </form>
        </div>
    </div>

    <hr class="mt-5 mb-4" />

    <div class="row" id="ratings-reviews">
        <div class="col-12">
            <h2>Product ratings and reviews</h2>
        </div>

        <div class="col-md-4">
            <div class="rating-summary">
                <div class="rating-score">@Model.AverageRating.ToString("F1")</div>

                <div class="star-display-large">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(Model.AverageRating))
                        {
                            <span style="color: #f57f17;">★</span>
                        }
                        else
                        {
                            <span style="color: #ccc;">☆</span>
                        }
                    }
                </div>

                <div>Based on @Model.ReviewCount ratings</div>
            </div>

            <div class="rating-bars">
                @foreach (var rating in sortedRatings)
                {
                    <div class="rating-bar-row">
                        <span class="rating-bar-label">@rating.Key stars</span>
                        <div class="progress">
                            @{
                                var percentage = (Model.ReviewCount > 0) ? (rating.Value * 100.0 / Model.ReviewCount) : 0;
                            }
                            <div class="progress-bar" role="progressbar" style="width: @percentage%;" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <span class="rating-bar-count">@rating.Value</span>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-8">
            <h3>Most relevant reviews</h3>

            @if (!Model.Reviews.Any())
            {
                <div class="review-card">
                    <p>Be the first to review this item.</p>
                </div>
            }

            @foreach (var review in Model.Reviews)
            {
                <div class="review-card">
                    <div class="review-header">
                        <span class="star-display">
                            @for (int i = 0; i < review.Rating; i++)
                            {
                                <span>★</span>
                            }
                            @for (int i = review.Rating; i < 5; i++)
                            {
                                <span class="star-empty">☆</span>
                            }
                        </span>
                    </div>
                    <h4 class="review-comment">@review.Comment</h4>
                    <div class="review-footer">
                        by @review.ReviewerUsername on @review.CreatedAt.ToShortDateString()
                        <span class="review-verified">| Verified purchase</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(paypalClientId))
{
    <script src="https://www.paypal.com/sdk/js?client-id=@paypalClientId&currency=@paypalCurrency&components=buttons"></script>
}

<script>
    (function () {
        var form = document.querySelector('.checkout-form');
        if (!form) return;

        var productId = Number(form.getAttribute('data-product-id'));
        var quantityInput = document.getElementById('quantity');
        var addressSelect = document.getElementById('addressId');
        var couponCodeInput = document.getElementById('couponCode'); // hidden input
        var couponListEl = document.getElementById('couponList');

        var subTotalEl = document.getElementById('summarySubTotal');
        var discountRowEl = document.getElementById('summaryDiscountRow');
        var discountEl = document.getElementById('summaryDiscount');
        var shippingEl = document.getElementById('summaryShippingFee');
        var totalEl = document.getElementById('summaryTotal');
        var errorEl = document.getElementById('summaryError');
        var couponMessageEl = document.getElementById('couponMessage');
        var paymentMethodSelect = document.getElementById('paymentMethod');
        var buyButton = form.querySelector('.btn-buy-now');
        var paypalContainer = document.getElementById('paypal-button-container');
        var paypalError = document.getElementById('paypal-error');

        var formatCurrency = function (value) {
            return 'US $' + Number(value || 0).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        };

        async function refreshTotal() {
            errorEl.textContent = '';
            couponMessageEl.textContent = '';
            couponMessageEl.classList.remove('text-danger', 'text-success');

            if (!addressSelect || !addressSelect.value) {
                errorEl.textContent = 'Vui lòng chọn địa chỉ giao hàng để xem tổng tiền.';
                return;
            }

            var payload = {
                productId: productId,
                quantity: Number(quantityInput.value) || 1,
                addressId: Number(addressSelect.value),
                couponCode: couponCodeInput.value ? couponCodeInput.value.trim() : null
            };

            try {
                var res = await fetch('/Product/CalculateTotal', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                var data = await res.json();

                if (!res.ok) {
                    var msg = data && data.message ? data.message : 'Không thể tính tổng tiền.';
                    errorEl.textContent = msg;
                    if (payload.couponCode) {
                        couponMessageEl.textContent = msg;
                        couponMessageEl.classList.add('text-danger');
                    }
                    return;
                }

                subTotalEl.textContent = formatCurrency(data.subTotal);
                shippingEl.textContent = formatCurrency(data.shippingFee);
                totalEl.textContent = formatCurrency(data.total);

                if (data.discountAmount && data.discountAmount > 0) {
                    discountRowEl.style.display = 'flex';
                    discountEl.textContent = '- ' + formatCurrency(data.discountAmount);
                } else {
                    discountRowEl.style.display = 'none';
                }

                if (payload.couponCode) {
                    if (data.appliedCoupon) {
                        couponMessageEl.textContent = 'Đã áp dụng mã "' + data.appliedCoupon + '".';
                        couponMessageEl.classList.add('text-success');
                    } else {
                        couponMessageEl.textContent = 'Mã giảm giá không áp dụng được.';
                        couponMessageEl.classList.add('text-danger');
                    }
                }
            } catch (err) {
                console.error('calculate-total error', err);
                errorEl.textContent = 'Có lỗi xảy ra, thử lại sau.';
            }
        }

        if (quantityInput) {
            quantityInput.addEventListener('input', function () {
                clearTimeout(quantityInput._debounce);
                quantityInput._debounce = setTimeout(refreshTotal, 400);
            });
        }
        if (addressSelect) addressSelect.addEventListener('change', refreshTotal);

        if (couponListEl) {
            var items = couponListEl.querySelectorAll('.coupon-item');
            items.forEach(function (item) {
                item.addEventListener('click', function () {
                    items.forEach(function (i) { i.classList.remove('selected'); });
                    item.classList.add('selected');
                    couponCodeInput.value = item.getAttribute('data-code') || '';
                    refreshTotal();
                });
            });
        }

        function getPayPalPayload() {
            return {
                productId: productId,
                addressId: addressSelect && addressSelect.value ? Number(addressSelect.value) : null,
                quantity: Number(quantityInput.value) || 1,
                couponCode: couponCodeInput.value ? couponCodeInput.value.trim() : null
            };
        }

        function setPaymentMethodUi() {
            var isPayPal = paymentMethodSelect && paymentMethodSelect.value === 'PayPal';
            if (buyButton) buyButton.style.display = isPayPal ? 'none' : '';
            if (paypalContainer) paypalContainer.style.display = isPayPal ? 'block' : 'none';
            if (paypalError) paypalError.textContent = '';
        }

        if (paymentMethodSelect) {
            paymentMethodSelect.addEventListener('change', setPaymentMethodUi);
            setPaymentMethodUi();
        }

        if (window.paypal && paypalContainer) {
            paypal.Buttons({
                style: { layout: 'vertical', shape: 'rect', label: 'paypal' },
                createOrder: function () {
                    var payload = getPayPalPayload();
                    if (!payload.addressId) {
                        var error = 'Vui lòng chọn địa chỉ giao hàng.';
                        paypalError.textContent = error;
                        return Promise.reject(new Error(error));
                    }

                    paypalError.textContent = '';
                    return fetch('/Product/CreatePayPalOrder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(async function (response) {
                        var data = await response.json();
                        if (!response.ok || !data.id) {
                            throw new Error(data.message || 'Không thể tạo đơn PayPal.');
                        }
                        window.paypalLocalOrderId = data.orderId;
                        return data.id;
                    })
                    .catch(function (error) {
                        paypalError.textContent = error.message;
                        throw error;
                    });
                },
                onApprove: function (data) {
                    return fetch('/Product/CapturePayPalOrder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            orderId: window.paypalLocalOrderId,
                            paypalOrderId: data.orderID
                        })
                    })
                    .then(async function (response) {
                        var result = await response.json();
                        if (!response.ok || result.paymentStatus !== 'Paid') {
                            throw new Error(result.message || 'PayPal chưa hoàn tất thanh toán.');
                        }
                        window.location.href = '/Purchase/Index';
                    })
                    .catch(function (error) {
                        paypalError.textContent = error.message;
                    });
                },
                onCancel: function () {
                    paypalError.textContent = 'Bạn đã hủy thanh toán PayPal.';
                },
                onError: function (error) {
                    console.error('PayPal error', error);
                    paypalError.textContent = 'Có lỗi xảy ra với PayPal. Vui lòng thử lại.';
                }
            }).render('#paypal-button-container');
        }

        refreshTotal();
    })();

    (function(){
        var btn = document.getElementById('chat-with-seller');
        if(!btn) return;
        btn.addEventListener('click', function(){
            var id = btn.getAttribute('data-seller-id');
            var name = btn.getAttribute('data-seller-name');
            try{
                if(window.openChatWith){
                    window.openChatWith(id, name);
                } else {
                    localStorage.setItem('chat_target_user', JSON.stringify({ id: id, name: name }));
                    var toggle = document.getElementById('chat-toggle-btn'); if(toggle) toggle.click();
                }
            }catch(e){ console.error('open chat error', e); }
        });
    })();
</script>
